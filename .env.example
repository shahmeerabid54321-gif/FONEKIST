# Commerce backend (server-side calls)
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable key: scopes this storefront to the FONEKIST sales channel (ADR-022). This is
# what makes the catalog phone-only, so the Voltmark key here would silently widen the shop.
# `pnpm --filter commerce seed` prints both keys; take the one labelled FONEKIST.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Public site origin, used for canonical URLs and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Merchant runtime configuration (TRD section 14)
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
# The shop's WhatsApp, in international form (e.g. +923001234567). It is the number the
# application handoff opens a chat with; leave it empty and that button does not render.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_PKR=50000

# Commerce enforces the same figure via RETURN_WINDOW_DAYS; set both together.
NEXT_PUBLIC_RETURN_WINDOW_DAYS=7

# Media host for remote images (ADR-012). Empty means no remote host is optimised.
NEXT_PUBLIC_MEDIA_HOST=

# Origin serving catalog media. Leave EMPTY: this storefront serves its own imagery from
# public/media, which `pnpm sync:media` copies out of the shared backend's seed output. It
# used to point at the other storefront's origin, which meant FONEKIST loaded its pictures
# from a second shop that only happens to be running on the same machine.
# Set this only for a CDN in production (ADR-012). See src/lib/media.ts.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Feature gates. Off by default and enabled only after their acceptance passes clear;
# installments additionally needs the legal review (ADR-023).
NEXT_PUBLIC_FEATURE_COMPARISON=false
NEXT_PUBLIC_FEATURE_INSTALLMENTS=false
