{
  "name": "fonekist",
  "version": "0.1.0",
  "private": true,
  "description": "FONEKIST \u2014 phone-only Pakistani storefront on the shared Medusa commerce backend.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "sync:media": "node scripts/sync-media.mjs"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
