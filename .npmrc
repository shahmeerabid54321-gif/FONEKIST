public-hoist-pattern[]=*@medusajs/*
public-hoist-pattern[]=@tanstack/react-query
public-hoist-pattern[]=react-i18next
public-hoist-pattern[]=react-router-dom

strict-peer-dependencies=false

# Deliberately NOT auto-installing peers: it resolves Next's optional @types/react peer to
# v18, which puts two incompatible copies of React's JSX types in the same program. Peers we
# actually need are declared explicitly in package.json instead.
auto-install-peers=false
