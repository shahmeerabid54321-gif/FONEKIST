# ---- Database (ADR-003: PostgreSQL is transactional truth) ----
DATABASE_URL=postgres://localhost:5432/pk_electronics
# The defaults are sized for one Medusa process on Render's smallest Postgres plan.
# Override these only after accounting for every process that shares the database.
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=20
DATABASE_ACQUIRE_TIMEOUT_MS=120000
DATABASE_IDLE_TIMEOUT_MS=30000

# ---- HTTP / CORS (TRD section 10: strict allowlist, never a wildcard) ----
# Two storefronts share this backend (ADR-022): Voltmark on 3000, FONEKIST on 3001.
STORE_CORS=http://localhost:3000,http://localhost:3001
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3000,http://localhost:3001

# ---- Secrets (SEC-003: never commit real values) ----
JWT_SECRET=change-me-in-every-environment
COOKIE_SECRET=change-me-in-every-environment

# ---- Optional infrastructure (ADR-019) ----
# Leave REDIS_URL empty locally to use in-memory event bus / cache / workflow engine.
# Staging and production must set it.
REDIS_URL=

# Provisioning normally reconciles photos and the search index only for a new database.
# Set this for one boot after an intentional catalogue/media migration, then unset it.
RECONCILE_CATALOG_ON_BOOT=false

# ---- Merchant runtime configuration (TRD section 14: changeable without a deploy) ----
COD_MAX_ORDER_VALUE_PKR=150000
FREE_SHIPPING_THRESHOLD_PKR=50000

# Return window. Enforced here; the storefront prints the same figure from
# NEXT_PUBLIC_RETURN_WINDOW_DAYS and the two must be set together.
RETURN_WINDOW_DAYS=7

# Order value at or above which a COD order must be confirmed by phone before dispatch
# (PAY-005). The risk scales with the order, so the cheapest ones are not made harder.
COD_VERIFICATION_THRESHOLD_PKR=25000

# Keys the confirmation-code HMAC. Falls back to JWT_SECRET when unset; set it separately
# in production so rotating one does not invalidate the other.
COD_VERIFICATION_SECRET=

# Printed at the end of customer notifications.
SUPPORT_PHONE=+92 21 1234567

# ---- Payment provider (sandbox stub until a real provider is contracted) ----
SANDBOX_PAYMENT_API_KEY=sandbox_key
SANDBOX_PAYMENT_WEBHOOK_SECRET=sandbox_webhook_secret
SANDBOX_PAYMENT_BASE_URL=http://localhost:9000/sandbox-psp

# ---- Storefront origin, used to build payment return URLs ----
# Read by nothing today. When payment return URLs are wired, they must be resolved
# per storefront (ADR-022) or FONEKIST customers are returned to Voltmark after paying.
STOREFRONT_URL=http://localhost:3000

# ---- Observability ----
SENTRY_DSN=
LOG_LEVEL=info

# ---------------------------------------------------------------- Installments
# Retail ceiling for a single installment order (ADR-023).
INSTALLMENT_MAX_ORDER_VALUE_PKR=500000
# How long a submitted application holds its stock reservation before it expires and the
# unit is released (INST-009). Reviewing takes hours, not days; the default is generous.
INSTALLMENT_RESERVATION_TTL_HOURS=48
# Days after a rejection, cancellation or settled receivable before CNIC values and
# document bytes are deleted (SEC-007, ADR-025). The decision record itself is kept.
INSTALLMENT_DOCUMENT_RETENTION_DAYS=90
# Version of the consent and disclosure text currently shown. Changing the text means
# changing this, so an application records which wording the customer actually agreed to.
INSTALLMENT_TERMS_VERSION=2026-08-27

# ------------------------------------------------------------ Document storage
# Encryption key for identity documents at rest. At least 32 characters. SEC-003: never
# commit a real value.
DOCUMENT_ENCRYPTION_SECRET=
# HMAC key for the short-lived reviewer links that serve a document (ADR-024).
DOCUMENT_LINK_SECRET=
# Where the local filesystem driver writes. Ignored once S3 is provisioned (ADR-012).
DOCUMENT_STORE_ROOT=./.documents
# ClamAV, scanned on upload. If unset, nothing can be scanned clean and therefore nothing
# can be opened by a reviewer: the flow fails closed rather than pretending it is protected.
CLAMAV_HOST=
CLAMAV_PORT=3310
