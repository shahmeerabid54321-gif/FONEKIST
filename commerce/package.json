{
  "name": "commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Medusa 2.x commerce core \u2014 authoritative for catalog, price, inventory, cart, order, payment and fulfilment.",
  "scripts": {
    "build": "medusa build",
    "dev": "medusa develop",
    "start": "medusa start",
    "db:migrate": "medusa db:migrate",
    "db:generate": "medusa db:generate",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "search:reindex": "medusa exec ./src/scripts/reindex-search.ts",
    "media:placeholders": "medusa exec ./src/scripts/generate-placeholder-media.ts",
    "user": "medusa user",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: handled by tsc for now'",
    "test": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:contract": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests --testPathPattern=contract",
    "test:integration": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "media:photos": "medusa exec ./src/scripts/fetch-placeholder-photos.ts",
    "installments:jobs": "medusa exec ./src/scripts/run-installment-jobs.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/admin-shared": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/dashboard": "2.19.0",
    "@medusajs/draft-order": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/ui": "^4.0.0",
    "@pk/contracts": "workspace:*",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.19.0",
    "@swc/core": "^1.10.1",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.14"
  },
  "engines": {
    "node": ">=22"
  }
}
